{
  "name": "monivitals-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web companion app for the MoniVitals ECG/BioZ/PPG wearable (research tool, not a medical device)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
